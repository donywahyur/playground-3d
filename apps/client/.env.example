# Colyseus server. Defaults to ws(s)://<page host>:2567 when unset.
# VITE_SERVER_URL=wss://your-server.fly.dev
# Dev through the Vite proxy (same origin as the page): VITE_SERVER_URL=/colyseus

# TURN is configured on the server (CF_TURN_KEY_ID / CF_TURN_API_TOKEN), never here:
# anything prefixed VITE_ ends up in the public bundle.
